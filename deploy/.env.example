# 课题组服务器版环境变量（复制为 deploy/.env 后修改）
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=reviewdesk
S3_SECRET_KEY=change-me-too
# openssl rand -hex 32
REVIEWDESK_SECRET_KEY=
REVIEWDESK_BOOTSTRAP_ADMIN_EMAIL=admin@lab.local
REVIEWDESK_BOOTSTRAP_ADMIN_PASSWORD=
HTTP_PORT=8000

# 模型网关：rules（离线规则引擎）| cloud | ollama；也可登录后在“平台管理 → 模型网关”按任务配置
REVIEWDESK_DEFAULT_PROVIDER=rules
# 云端 API（OpenAI 兼容），例如 DeepSeek
REVIEWDESK_OPENAI_BASE_URL=https://api.deepseek.com/v1
REVIEWDESK_OPENAI_API_KEY=
REVIEWDESK_OPENAI_MODEL=deepseek-chat
# 本地模型（启用 --profile gpu 时）：http://vllm:8000/v1
REVIEWDESK_LOCAL_LLM_URL=
REVIEWDESK_LOCAL_LLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
# PDF 解析（启用 --profile grobid 时）：http://grobid:8070
REVIEWDESK_GROBID_URL=

# 外部数据源
REVIEWDESK_NCBI_API_KEY=
REVIEWDESK_NCBI_EMAIL=
REVIEWDESK_CROSSREF_MAILTO=
REVIEWDESK_UNPAYWALL_EMAIL=
REVIEWDESK_OPENALEX_API_KEY=
# 纯内网部署时设为 true：禁止一切外部请求，并强制只用本地模型
REVIEWDESK_OFFLINE=false
